# Copy to .env.local for local development, and set the same variables in your host (e.g. Vercel).
# Never commit real values.

# --- Sanity (public: safe to expose to the browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: pin the Sanity API version (YYYY-MM-DD)
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://kfraileyfineart.com

# --- Server-only secrets ---
# Shared secret for the Sanity publish webhook → /api/revalidate (32+ random characters,
# e.g. `openssl rand -base64 32`). Must match the secret entered in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Only needed to run the WordPress migration (npm run migrate). Editor-level token from
# sanity.io/manage → API → Tokens. Do NOT set this in the hosting environment.
SANITY_API_WRITE_TOKEN=

# Contact form delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate for several addresses)
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend
CONTACT_FROM_EMAIL="Kristen Frailey Fine Art <website@kfraileyfineart.com>"

# Testing only: point the site at a local stand-in API. Leave unset everywhere else.
# SANITY_API_HOST=
